  <modelVersion>4.0.0</modelVersion>
  <groupId>io.github.okay-effects</groupId>
  <artifactId>okay-direct-otel</artifactId>
  <version>0.1.0</version>
  <name>okay-direct-otel</name>
  <description>okay-direct: algebraic effects in direct style on the JVM — perform a method call, handle a body; one API, implementations on Loom, threads and Espresso (multi-shot); Scala 3 and 2.13 front ends; cats-effect and ZIO</description>
