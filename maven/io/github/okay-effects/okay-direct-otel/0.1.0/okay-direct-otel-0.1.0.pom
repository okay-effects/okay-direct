    </developer>
  </developers>
  <scm>
    <connection>scm:git:https://github.com/okay-effects/okay-direct.git</connection>
    <url>https://github.com/okay-effects/okay-direct</url>
  </scm>
  <dependencies>
    <dependency>
      <groupId>io.github.okay-effects</groupId>
      <artifactId>okay-direct-api</artifactId>
      <version>0.1.0</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>io.opentelemetry</groupId>
      <artifactId>opentelemetry-api</artifactId>
      <version>1.67.0</version>
      <scope>compile</scope>
    </dependency>
